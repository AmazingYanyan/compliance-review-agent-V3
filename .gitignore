node_modules/
dist/
.vite/
*.tsbuildinfo
.eslintcache

# --- Docker ---
.docker-data/

# --- OS / Editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs / runtime ---
*.log
pnpm-debug.log*