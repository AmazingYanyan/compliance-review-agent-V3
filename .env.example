# ---------------------------------------------------------------------------
# 合规审查智能体 V3 - 环境变量样例
# 复制为 .env 后按需修改；docker compose 会自动读取根目录 .env
# ---------------------------------------------------------------------------

# --- 后端应用 ---
APP_NAME=compliance-review-agent
APP_ENV=development
DEBUG=true
# 后端监听地址（容器内为 0.0.0.0）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- 数据库 ---
# 宿主机运行后端时指向本机/宿主机暴露的 PostgreSQL 端口
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5433/compliance
# Procrastinate 队列使用同库；必须使用 psycopg 驱动（同步语义由异步封装提供）
PROCRASTINATE_DATABASE_URL=postgresql://compliance:compliance@localhost:5433/compliance

# --- JWT / 会话 ---
# 生产环境务必替换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh Cookie 名称
REFRESH_COOKIE_NAME=refresh_token
# Cookie 的 SameSite：本地同源代理用 lax，跨站部署用 none
COOKIE_SAMESITE=lax
# HTTPS 环境设为 true
COOKIE_SECURE=false

# --- 注册开关 ---
# 开发环境默认开启注册；关闭后后端 /api/v1/auth/register 返回 403
REGISTRATION_ENABLED=true

# --- CORS / 来源校验 ---
# 允许的前端来源，逗号分隔
ALLOWED_ORIGINS=http://localhost:3006,http://127.0.0.1:3006

# --- Procrastinate worker ---
PROCRASTINATE_CONCURRENCY=2

# --- 前端 ---
# 开发环境 Vite 代理指向后端；Compose 内指向后端服务名
VITE_API_PROXY_URL=http://localhost:8000
VITE_PORT=3006
